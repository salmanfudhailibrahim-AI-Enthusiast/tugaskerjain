<resources>
<!--  Tema dasar GELAP: popup spinner, dialog, dan teks otomatis terbaca di latar gelap.  -->
<style name="AppTheme" parent="android:Theme.Material.NoActionBar">
<item name="android:colorPrimary">#881337</item>
<item name="android:colorPrimaryDark">@color/bg0</item>
<item name="android:colorAccent">@color/burgundyLight</item>
<item name="android:colorControlActivated">@color/burgundyLight</item>
<item name="android:windowBackground">@color/bg0</item>
<item name="android:statusBarColor">@color/bg0</item>
<item name="android:navigationBarColor">@color/bg0</item>
<item name="android:textColorPrimary">@color/text</item>
<item name="android:textColorSecondary">@color/mute</item>
<item name="android:alertDialogTheme">@style/AppDialog</item>
</style>
<style name="AppDialog" parent="android:Theme.Material.Dialog.Alert">
<item name="android:windowBackground">@drawable/dialog_bg</item>
<item name="android:colorAccent">@color/burgundyLight</item>
<item name="android:textColorPrimary">@color/text</item>
<item name="android:textColorSecondary">@color/mute</item>
</style>
</resources>
